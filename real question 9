k get gatewayclass

k get ingress   
k edit ingress web
//copy this part into a notepad
spec:
  ingressClassName: nginx
  rules:
  - host: ingress.web.k8s.local
    http:
      paths:
      - backend:
          service:
            name: web
            port:
              number: 80
        path: /
        pathType: Prefix
  tls:
  - hosts:
    - ingress.web.k8s.local
    secretName: web-cert

vi gateway.yaml
//
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: web-gateway                              //UPDATE
    # namespace: example-namespace                //NO NEED
spec:
  gatewayClassName: nginx                        //UPDATE
  listeners:
  - name: https                                  //UPDATE
    protocol: HTTPS                              //UPDATE
    port: 443                                    //UPDATE
    hostname: "gateway.web.k8s.local"            //UPDATE
    tls:
      certificateRefs:
      - group: ""
        kind: Secret
        name: web-cert                            //UPDATE
k apply -f gateway.yaml    //只有加密协议（HTTPS / TLS）才能配置 tls, HTTP / TCP / UDP 都不能写 tls

vi hr.yaml
//
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: web-route                                  //UPDATE
spec:
  parentRefs:
  - name: web-gateway                              //UPDATE
  hostnames:
  - "gateway.web.k8s.local"                        //UPDATE
  rules:
  - matches:
    - path:
        type: PathPrefix
        value: /                                    //UPDATE
    backendRefs:
    - name: web                                      //UPDATE: service name in ingress
      port: 80                                       //UPDATE

k apply -f hr.yaml

//verify
curl -Lk https://gateway.web.k8s.local:31443

k delete ingress web                                  //dont forget
