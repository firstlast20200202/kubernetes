$ k -n sound-repeater get ingressclasses
nginx

$ vi ingress.yaml
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: echo
  namespace: sound-repeater
  annotations: 
    nginx.ingress.kubernetes.io/rewrite-target: /                //there's a space before /
spec:
  ingressClassName: nginx
  rules:
  - host: "example.org"
    http:
      paths:
      - path: /echo
        pathType: Prefix
        backend:
          service:
            name: echoserver-service 
            port:
              number: 8080

$ k -n sound-repeater apply -f ingress.yaml

//verify
$ curl http://example.org/echo
