$ k -n mariadb get pv    //get StorageClass
local-path

$ vi pvc.yaml

apiVersion: v1
kind: PersistentVolumeClaim
metadata:
 name: mariadb
 namespace: mariadb
spec:
 storageClassName: local-path
 accessModes:
 - ReadWriteOnce
 resources:
 requests:
 storage: 250Mi 

$ k -n mariadb apply -f pvc.yaml

$ vi mariadb-deployment.yaml
//just add claimName

$ k apply -f ~/mariadb-deployment.yaml

//verify
kubectl -n mariadb get deployment
kubectl -n mariadb get pod
